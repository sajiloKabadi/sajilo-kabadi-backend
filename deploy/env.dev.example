# Template for /opt/sajilokabadi/.env on the EC2 dev server.
# Copy it there, fill in every <...>, then `chmod 600 .env`.
# This file in the repo must never contain real values.

# --- PostgreSQL container ---
POSTGRES_DB=sajilokabadi
POSTGRES_USER=sajilokabadi
# openssl rand -hex 24   (hex only, so it is safe inside DATABASE_URL)
POSTGRES_PASSWORD=<generated-password>

# --- Django ---
# Same password as above. Host is the compose service name, not localhost.
DATABASE_URL=postgresql://sajilokabadi:<generated-password>@postgres:5432/sajilokabadi
# openssl rand -base64 48 | tr -d '\n=/+'
SECRET_KEY=<generated-secret-key>
DEBUG=False
# Your hostname, plus 127.0.0.1/localhost for the internal health checks.
ALLOWED_HOSTS=api.sajilokabadi.com,127.0.0.1,localhost
CSRF_TRUSTED_ORIGINS=https://api.sajilokabadi.com
# Web frontends allowed to call the API from a browser (comma-separated).
CORS_ALLOWED_ORIGINS=http://localhost:3000,http://localhost:5173
# Nginx overwrites X-Forwarded-For with the real client IP.
USE_X_FORWARDED_FOR=True

# --- SMS (Aakash) ---
SMS_BACKEND=apps.notifications.backends.aakash.AakashSMSBackend
AAKASH_SMS_AUTH_TOKEN=<aakash-token>
# No Celery worker on the dev server; send from a background thread.
SMS_DISPATCH=thread
SMS_APP_HASH=

# --- Test OTP ---
# Fixed code for the numbers listed below, no SMS sent. The server refuses
# to start if OTP_TEST_CODE is set without OTP_TEST_PHONES.
OTP_TEST_CODE=202610
OTP_TEST_PHONES=9800000001,9800000002,9800000003

# --- Push notifications (FCM). Without these, pushes are only logged. ---
# PUSH_BACKEND=apps.notifications.backends.fcm.FCMPushBackend
# FCM_PROJECT_ID=<firebase-project-id>
# FCM_CREDENTIALS_FILE=/app/secrets/firebase.json

# Force old app builds to update (426 app_update_required). Empty = off.
MIN_APP_VERSION=
