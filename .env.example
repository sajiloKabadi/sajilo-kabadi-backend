DJANGO_SETTINGS_MODULE=config.settings.dev
SECRET_KEY=change-me-in-production
DEBUG=True
ALLOWED_HOSTS=localhost,127.0.0.1

DB_NAME=sajilokabadi
DB_USER=sajilokabadi
DB_PASSWORD=sajilokabadi
DB_HOST=localhost
DB_PORT=5432

REDIS_URL=redis://localhost:6379/0

# --- SMS (Aakash SMS) ---
# Dev defaults to printing codes to the console; set SMS_BACKEND to use Aakash.
SMS_BACKEND=apps.notifications.backends.aakash.AakashSMSBackend
AAKASH_SMS_AUTH_TOKEN=
AAKASH_SMS_API_URL=https://sms.aakashsms.com/sms/v3/send
# celery (needs a running worker) | thread (in-process) | sync
SMS_DISPATCH=thread
# 11-char Android SMS Retriever app hash for the build this server serves
SMS_APP_HASH=

# --- Test OTP (testing only) ---
# Fixed code issued instead of a random one; no SMS is sent. Limit it with
# OTP_TEST_PHONES (comma-separated); production refuses to start without it.
OTP_TEST_CODE=
OTP_TEST_PHONES=

# --- OTP (must match the Flutter client's compiled constants) ---
OTP_LENGTH=6
OTP_EXPIRY_SECONDS=300
OTP_RESEND_AFTER_SECONDS=30
OTP_MAX_VERIFY_ATTEMPTS=5
OTP_LOCKOUT_SECONDS=600
OTP_PHONE_LIMIT_PER_HOUR=5
OTP_PHONE_LIMIT_PER_DAY=20
OTP_IP_LIMIT_PER_HOUR=30
# Only behind a proxy that overwrites X-Forwarded-For
USE_X_FORWARDED_FOR=False

# --- JWT ---
JWT_ACCESS_LIFETIME_SECONDS=3600
JWT_REFRESH_LIFETIME_SECONDS=2592000
